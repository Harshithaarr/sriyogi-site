// ── EVENT GALLERY (Guru Purnima 2025) ───────────────────────────────────
// General (unattributed) photographs from the 2025 Mahotsava — procession,
// homa, performances, and so on — shown in the "Previous Guru Purnima
// Mahotsavas" archive section, not the current one. Drop images into
// public/images/guru-purnima/gallery-2025/ and they appear here
// automatically, in filename order. No code change needed.
const GALLERY_DIR = 'public/images/guru-purnima/gallery-2025';

let gallery = [];
try {
  gallery = fs
    .readdirSync(path.join(process.cwd(), GALLERY_DIR))
    .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
    .sort()
    .map((f) => `/images/guru-purnima/gallery-2025/${f}`);
} catch {
  gallery = [];
}

// ── DISTINGUISHED GUESTS ────────────────────────────────────────────────
// Photographs are picked up automatically at build time from
// public/images/guru-purnima/guests/<slug>/ — drop images into a guest's
// folder and they appear, in filename order. No code change needed.
// A guest with no photographs yet is simply skipped.
const GUEST_DIR = 'public/images/guru-purnima/guests';

const guestList = [
  { slug: 'justice-hanchate-sanjeevkumar', name: 'Justice Hanchate Sanjeevkumar', role: 'High Court Judge' },
  { slug: 'k-prashant-kumar', name: 'Sri K. Prashant Kumar', role: 'Deputy Director, Information & Broadcasting, Government of India' },
  { slug: 'gr-reddy', name: 'Sri G. R. Reddy', role: 'Former Income Tax Commissioner' },
  { slug: 'sudheer-hegde', name: 'Sri Sudheer Hegde', role: 'Deputy Superintendent of Police' },
  { slug: 'padma-vasanthi', name: 'Smt. Padma Vasanthi', role: 'Kannada Actress' },
  { slug: 'shilpa-iyer', name: 'Smt. Shilpa Iyer', role: 'Kannada Actress' },
];

const guests = guestList
  .map((g) => {
    const dir = path.join(process.cwd(), GUEST_DIR, g.slug);
    let photos = [];
    try {
      photos = fs
        .readdirSync(dir)
        .filter((f) => /\.(jpe?g|png|webp)$/i.test(f))
        .sort()
        .map((f) => `/images/guru-purnima/guests/${g.slug}/${f}`);
    } catch {
      photos = [];
    }
    return { ...g, photos };
  })
  .filter((g) => g.photos.length > 0);

const sorted = [...posts].sort((a, b) => new Date(b.date) - new Date(a.date));
const fmt = (d) =>
  new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Guru Purnima"
  description="Posts and photographs from the Guru Purnima Mahotsava celebrated in the divine presence of Sri Yogi."
>
  <PageHeader
    eyebrow="Mahotsava"
    title="Guru Purnima"
    lead="Posts and photographs from the Guru Purnima Mahotsava, celebrated in the divine presence of Sri Yogi."
  />

  <section class="section">
    <div class="container">
      <div class="post-list">
        {sorted.map((p) => (
          <article class="post">
            <div class="post-meta">
              <span class="source">{p.source}</span>
              <time datetime={p.date}>{fmt(p.date)}</time>
            </div>

            {p.photo && (
              p.url
                ? <a href={p.url} target="_blank" rel="noopener" class="post-photo">
                    <img src={p.photo} alt={p.title} loading="lazy" />
                  </a>
                : <div class="post-photo"><img src={p.photo} alt={p.title} loading="lazy" /></div>
            )}

            <h2>{p.title}</h2>
            {p.body.map((para) => <p class="muted">{para}</p>)}

            {p.url && (
              <a href={p.url} target="_blank" rel="noopener" class="post-link">
                {p.cta ?? 'View the post →'}
              </a>
            )}
          </article>
        ))}
      </div>

    </div>
  </section>

  {guests.length > 0 && (
    <section class="section" id="guests">
      <div class="container">
        <div class="awards-head">
          <span class="eyebrow">In Attendance</span>
          <h2>Distinguished Guests</h2>
          <p class="muted awards-lead">
            Dignitaries who joined the Mahotsava in the divine presence of Sri Yogi.
          </p>
        </div>

        <div class="guest-list">
          {guests.map((g) => (
            <article class="guest">
              <div class="guest-id">
                <h3>{g.name}</h3>
                <p class="guest-role">{g.role}</p>
              </div>
              <ul class="guest-photos">
                {g.photos.map((src, i) => (
                  <li>
                    <img
                      src={src}
                      alt={`${g.name} at the Guru Purnima Mahotsava`}
                      loading="lazy"
                      class:list={[i === 0 && 'is-lead']}
                    />
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tint" id="awards">
    <div class="container">
      <div class="awards-head">
        <span class="eyebrow">Honoured at the Mahotsava</span>
        <h2>Paramahamsa Awards</h2>
        <p class="muted awards-lead">
          {awards.length} recipients were honoured in the divine presence of Sri Yogi for
          excellence, seva and devotion to the Guru Parampara.
        </p>
      </div>

      <div class="carousel">
        <button type="button" class="c-btn c-btn--prev" data-dir="-1" aria-label="Previous awardees" hidden>‹</button>

        <ul class="awards-track" tabindex="0" aria-label="Award recipients">
          {awards.map((a) => (
            <li class="award-card">
              <div class="award-photo">
                <img src={a.photo} alt={`${a.name} receiving the ${a.award}`} loading="lazy" width="1300" height="865" />
              </div>
              <div class="award-body">
                <span class="award-name">{a.award}</span>
                <h3>{a.name}</h3>
                {a.note && <p class="award-note">{a.note}</p>}
                <p class="muted">{a.citation}</p>
              </div>
            </li>
          ))}
        </ul>

        <button type="button" class="c-btn c-btn--next" data-dir="1" aria-label="More awardees" hidden>›</button>
      </div>

      <p class="carousel-hint muted">
        Swipe, or use the arrows, to see every recipient.
        <button type="button" class="c-pause" aria-pressed="false" hidden>Pause</button>
      </p>
    </div>
  </section>

  {/* Archive of earlier Mahotsavas. Guru Purnima 2025 is the first entry;
      a future year gets its own gallery/awards2026-style pair alongside it. */}
  <section class="section" id="archive">
    <div class="container">
      <div class="awards-head">
        <span class="eyebrow">Archive</span>
        <h2>Previous Guru Purnima Mahotsavas</h2>
        <p class="muted awards-lead">
          Photographs and honoured recipients from past Mahotsavas.
        </p>
      </div>

      {gallery.length > 0 && (
        <>
          <h3 class="archive-subhead">Guru Purnima 2025 — Gallery</h3>
          <ul class="gallery-grid">
            {gallery.map((src) => (
              <li>
                <img src={src} alt="Guru Purnima Mahotsava 2025" loading="lazy" />
              </li>
            ))}
          </ul>
        </>
      )}

      {awards2025.length > 0 && (
        <>
          <h3 class="archive-subhead">Guru Purnima 2025 — Paramahamsa Awards</h3>
          <div class="carousel">
            <button type="button" class="c-btn c-btn--prev" data-dir="-1" aria-label="Previous awardees" hidden>‹</button>

            <ul class="awards-track" tabindex="0" aria-label="2025 award recipients">
              {awards2025.map((a) => (
                <li class="award-card">
                  <div class="award-photo">
                    <img src={a.photo} alt={`${a.name} receiving the ${a.award}`} loading="lazy" width="1300" height="865" />
                  </div>
                  <div class="award-body">
                    <span class="award-name">{a.award}</span>
                    <h3>{a.name}</h3>
                    {a.note && <p class="award-note">{a.note}</p>}
                    <p class="muted">{a.citation}</p>
                  </div>
                </li>
              ))}
            </ul>

            <button type="button" class="c-btn c-btn--next" data-dir="1" aria-label="More awardees" hidden>›</button>
          </div>

          <p class="carousel-hint muted">
            Swipe, or use the arrows, to see every recipient.
            <button type="button" class="c-pause" aria-pressed="false" hidden>Pause</button>
          </p>
        </>
      )}
    </div>
  </section>

  {/* Arrows are revealed only once this runs, so they are never dead controls.
      Without JS the track is still a normal horizontally scrollable list. */}
  <script>
    document.querySelectorAll('.carousel').forEach((c) => {
      const track = c.querySelector('.awards-track');
      const prev = c.querySelector('.c-btn--prev');
      const next = c.querySelector('.c-btn--next');
      const pauseBtn = c.parentElement.querySelector('.c-pause');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const STEP_MS = 4500;
      const RESUME_MS = 9000;

      const step = () => {
        const card = track.querySelector('.award-card');
        return card ? card.getBoundingClientRect().width + 20 : track.clientWidth;
      };
      const maxScroll = () => track.scrollWidth - track.clientWidth - 2;

      // Arrows: revealed here so they are never dead controls without JS.
      [prev, next].forEach((b) => {
        b.hidden = false;
        b.addEventListener('click', () => {
          track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' });
        });
      });

      const sync = () => {
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= maxScroll();
      };
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();

      // ── Autoscroll ────────────────────────────────────────────────────
      // Runs only while the carousel is on screen, the visitor is not
      // interacting with it, and motion is not reduced. `paused` is the
      // visitor's explicit choice and always wins.
      let timer = null;
      let resume = null;
      let onScreen = false;
      let paused = reduce.matches;

      const advance = () => {
        if (track.scrollLeft >= maxScroll()) track.scrollTo({ left: 0, behavior: 'smooth' });
        else track.scrollBy({ left: step(), behavior: 'smooth' });
      };
      const stop = () => { clearInterval(timer); timer = null; };
      const start = () => {
        stop();
        if (!paused && onScreen && !reduce.matches) timer = setInterval(advance, STEP_MS);
      };
      // A touch or drag pauses, then hands control back after a quiet spell.
      const nudge = () => {
        stop();
        clearTimeout(resume);
        resume = setTimeout(start, RESUME_MS);
      };

      c.addEventListener('pointerenter', stop);
      c.addEventListener('pointerleave', start);
      c.addEventListener('focusin', stop);
      c.addEventListener('focusout', start);
      ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach((e) =>
        track.addEventListener(e, nudge, { passive: true })
      );

      pauseBtn.hidden = false;
      pauseBtn.addEventListener('click', () => {
        paused = !paused;
        pauseBtn.textContent = paused ? 'Play' : 'Pause';
        pauseBtn.setAttribute('aria-pressed', String(paused));
        paused ? stop() : start();
      });
      if (paused) {
        pauseBtn.textContent = 'Play';
        pauseBtn.setAttribute('aria-pressed', 'true');
      }

      new IntersectionObserver(
        ([entry]) => { onScreen = entry.isIntersecting; onScreen ? start() : stop(); },
        { threshold: 0.25 }
      ).observe(c);

      reduce.addEventListener('change', () => { paused = reduce.matches; start(); });
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    });
  </script>
</BaseLayout>

