---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

// ── GURU PURNIMA ────────────────────────────────────────────────────────
// Posts and photographs from the Guru Purnima Mahotsava.
//
// TO ADD A POST: copy a block below. `date` is YYYY-MM-DD; newest first is
// handled automatically. `photo` is optional — put the image in
// public/media/ (or public/images/guru-purnima/) and reference it here.
// `url` is optional too; without it the post shows as text only.
//
// The registration page for the 2026 event lives at /guru-purnima/register/.
// It is kept online for anyone holding an old link, but is not in the nav.

const posts = [
  {
    source: 'SriYogi on YouTube',
    date: '2026-08-01',
    title: 'Guru Purnima Mahotsava 2026 — Kuchalamba Kalyana Mahal, Jayanagar',
    body: [
      'Thousands of devotees gathered at Kuchalamba Kalyana Mahal, Jayanagar, Bengaluru, on 29 July 2026 to celebrate the sacred occasion of Guru Purnima in the divine presence of His Holiness Srimath Paramahamsa Parivrajakacharya Sri Sri Sri Yogishwara Swami (Sri Yogi).',
      'Sri Yogi delivered an inspiring discourse on the true meaning of Guru Purnima — self-realisation, meditation and inner transformation.',
    ],
    photo: '/media/youtube-guru-purnima-2026-08-01.jpg',
    url: 'https://www.youtube.com/post/Ugkx8vmdwQ6szwNHYG9cvjZjKhtxMlkSEm7a',
    cta: 'View the post on YouTube →',
  },
];

const sorted = [...posts].sort((a, b) => new Date(b.date) - new Date(a.date));
const fmt = (d) =>
  new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Guru Purnima"
  description="Posts and photographs from the Guru Purnima Mahotsava celebrated in the divine presence of Sri Yogi."
>
  <PageHeader
    eyebrow="Mahotsava"
    title="Guru Purnima"
    lead="Posts and photographs from the Guru Purnima Mahotsava, celebrated in the divine presence of Sri Yogi."
  />

  <section class="section">
    <div class="container">
      <div class="post-list">
        {sorted.map((p) => (
          <article class="post">
            <div class="post-meta">
              <span class="source">{p.source}</span>
              <time datetime={p.date}>{fmt(p.date)}</time>
            </div>

            {p.photo && (
              p.url
                ? <a href={p.url} target="_blank" rel="noopener" class="post-photo">
                    <img src={p.photo} alt={p.title} loading="lazy" />
                  </a>
                : <div class="post-photo"><img src={p.photo} alt={p.title} loading="lazy" /></div>
            )}

            <h2>{p.title}</h2>
            {p.body.map((para) => <p class="muted">{para}</p>)}

            {p.url && (
              <a href={p.url} target="_blank" rel="noopener" class="post-link">
                {p.cta ?? 'View the post →'}
              </a>
            )}
          </article>
        ))}
      </div>

      <p class="archive-note muted">
        Looking for the 2026 seva registration details?
        <a href="/guru-purnima/register/">View the registration page →</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .post-list { max-width: 820px; margin: 0 auto; display: grid; gap: 3rem; }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .source {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--saffron-dark);
  }
  .post-meta time {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .post-photo {
    display: block;
    margin: 0 0 1.1rem;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .post-photo img {
    display: block;
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  a.post-photo:hover img { transform: scale(1.03); }

  .post h2 { color: var(--maroon); font-size: 1.5rem; line-height: 1.3; margin-bottom: 0.6rem; }
  .post .muted { margin-bottom: 0.7rem; }
  .post-link { font-weight: 600; font-size: 0.92rem; }

  .archive-note {
    max-width: 820px;
    margin: 3.5rem auto 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .post h2 { font-size: 1.25rem; }
    .post-list { gap: 2.2rem; }
  }
</style>
